# ---- planner ----
# heuristic = deterministic, no API key, what the tests and demo use
# llm       = real tool selection; falls back to heuristic if the call fails
PLANNER=heuristic
OPENAI_API_KEY=
PLANNER_MODEL=gpt-4o-mini

# ---- web_search provider ----
# offline = searches the bundled data/kb corpus (deterministic, no network)
# tavily  = real web search
SEARCH_PROVIDER=offline
TAVILY_API_KEY=

# ---- guards ----
MAX_STEPS=8
TOOL_TIMEOUT_S=10.0
TOOL_RETRIES=2
RETRY_BACKOFF_S=0.25

# ---- tracing ----
# none = off (default, zero overhead) | file = JSONL you can render | otlp = collector
TRACE_EXPORTER=none
TRACE_FILE=./data/trace.jsonl
# OTLP_ENDPOINT=http://localhost:4318/v1/traces
# LangSmith accepts OTLP. Implemented, never executed — no key was used here.
# OTLP_ENDPOINT=https://api.smith.langchain.com/otel/v1/traces
# OTLP_HEADERS=x-api-key=<your-langsmith-key>
